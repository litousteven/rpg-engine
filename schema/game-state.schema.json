{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "meta": {
      "type": "object",
      "properties": {
        "turn": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "ruleVersions": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "protoVer": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "uidCounter": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "intentCounter": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "turn",
        "revision",
        "seed",
        "ruleVersions",
        "protoVer",
        "uidCounter",
        "intentCounter"
      ],
      "additionalProperties": false
    },
    "world": {
      "type": "object",
      "properties": {
        "regions": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "controller": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
              },
              "contested": {
                "type": "boolean"
              }
            },
            "required": [
              "controller",
              "contested"
            ],
            "additionalProperties": false
          }
        },
        "market": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "index": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "pendingSupply": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "pendingDemand": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "index",
              "pendingSupply",
              "pendingDemand"
            ],
            "additionalProperties": false
          }
        },
        "delayed": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "dueTurn": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "effect": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "args": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {}
              },
              "source": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "dueTurn",
              "effect",
              "source"
            ],
            "additionalProperties": false
          }
        },
        "arcs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "arcId": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
              },
              "stage": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "slots": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^item\\.inst\\.\\d{6}$"
                    },
                    {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
                    },
                    {
                      "type": "string",
                      "pattern": "^tag:[a-z][a-z0-9_]*$"
                    },
                    {
                      "type": "string",
                      "pattern": "^loreRef:[a-z][a-z0-9_.]+$"
                    }
                  ]
                }
              },
              "branchHistory": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$"
                }
              }
            },
            "required": [
              "arcId",
              "stage",
              "slots",
              "branchHistory"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "regions",
        "market",
        "delayed",
        "arcs"
      ],
      "additionalProperties": false
    },
    "scene": {
      "type": "object",
      "properties": {
        "sceneId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        },
        "actorsPresent": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(player|npc\\.[a-z][a-z0-9_]*(\\.[a-z0-9_]+)*)$"
          }
        }
      },
      "required": [
        "sceneId",
        "tags",
        "actorsPresent"
      ],
      "additionalProperties": false
    },
    "actors": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "hp": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "level": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "gold": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "purse": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "membership": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
          },
          "l2": {
            "type": "boolean"
          },
          "profileRef": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
          },
          "drives": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            }
          }
        },
        "required": [
          "hp"
        ],
        "additionalProperties": false
      }
    },
    "ledgers": {
      "type": "object",
      "properties": {
        "inventory": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "uid": {
                    "type": "string",
                    "pattern": "^item\\.inst\\.\\d{6}$"
                  },
                  "template": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
                  },
                  "qty": {
                    "type": "number",
                    "const": 1
                  },
                  "rarity": {
                    "type": "string",
                    "enum": [
                      "common",
                      "uncommon",
                      "rare",
                      "epic",
                      "legendary"
                    ]
                  },
                  "basePrice": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "essence": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_]*$"
                    }
                  },
                  "loreRef": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
                  },
                  "abilities": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "slot": {
                          "type": "string",
                          "enum": [
                            "passive",
                            "active",
                            "cost"
                          ]
                        },
                        "primitive": {
                          "type": "string",
                          "pattern": "^[a-z][a-z0-9_]*$"
                        },
                        "rank": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 5
                        },
                        "cooldown": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        }
                      },
                      "required": [
                        "slot",
                        "primitive",
                        "rank"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "provenance": {
                    "type": "object",
                    "properties": {
                      "source": {
                        "type": "string",
                        "minLength": 1
                      },
                      "turn": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "roll": {
                        "type": "string",
                        "minLength": 1
                      },
                      "lineage": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    },
                    "required": [
                      "source",
                      "turn"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "uid",
                  "template",
                  "qty",
                  "rarity",
                  "essence",
                  "abilities",
                  "provenance"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "template": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
                  },
                  "qty": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  },
                  "rarity": {
                    "type": "string",
                    "enum": [
                      "common",
                      "uncommon",
                      "rare",
                      "epic",
                      "legendary"
                    ]
                  }
                },
                "required": [
                  "template",
                  "qty",
                  "rarity"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "factionRep": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": -100,
            "maximum": 100
          }
        },
        "npcAffinity": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "base": {
                "type": "integer",
                "minimum": -100,
                "maximum": 100
              },
              "personal": {
                "type": "integer",
                "minimum": -100,
                "maximum": 100
              }
            },
            "required": [
              "base",
              "personal"
            ],
            "additionalProperties": false
          }
        },
        "activeDirectives": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "directiveId": {
                "type": "string",
                "minLength": 1
              },
              "verb": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "target": {
                "type": "string",
                "minLength": 1
              },
              "ttlTurns": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "strength": {
                "type": "string",
                "enum": [
                  "hard",
                  "bias"
                ]
              }
            },
            "required": [
              "directiveId",
              "verb",
              "target",
              "ttlTurns",
              "strength"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "inventory",
        "factionRep",
        "npcAffinity",
        "activeDirectives"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "meta",
    "world",
    "scene",
    "actors",
    "ledgers"
  ],
  "additionalProperties": false
}
